# Key example for the GitHub Actions ENV_FILE secret. Replace placeholders.
# The workflow moves DB_ROOT_PASSWORD into MySQL-only .env.mysql, then appends
# APP_IMAGE and FIREBASE_CREDENTIALS_HOST_PATH to the app .env.
SPRING_PROFILES_ACTIVE=prod
DB_ROOT_PASSWORD=<long-random-root-password>
DB_DATABASE=orbit
DB_USERNAME=orbit_app
DB_PWD=<long-random-app-password>
ADMIN_USERNAME=<admin-user>
ADMIN_PASSWORD=<long-random-admin-password>
AI_API_KEY=<ocr-api-key>
AI_URL=<ocr-api-url>
AI_AUTH_HEADER=<ocr-auth-header>
S3_BUCKET=<existing-s3-bucket>
S3_REGION=<existing-s3-region>
# One AWS SDK credential source while uploads still use S3.
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
